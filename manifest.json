{
  "author": "@l3x.me",
  "manifest_version": 3,
  "name": "Monev Assistant",
  "version": "1.3",
  "description": "AI Auto-Fill form laporan magang di MagangHub Kemnaker",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "*://monev.maganghub.kemnaker.go.id/*",
    "https://date.nager.at/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["qris.jpeg"],
      "matches": ["*://monev.maganghub.kemnaker.go.id/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://monev.maganghub.kemnaker.go.id/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Monev Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
